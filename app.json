{
  "expo": {
    "name": "Yard",
    "slug": "yard-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "yard",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.yardlimo.app.dev"
    }
  }
}
